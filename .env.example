# Missing DB_PROVIDER preserves the existing PostgreSQL/CockroachDB behavior.
DB_PROVIDER=postgres

# Oracle settings are only required when DB_PROVIDER=oracle or when running
# `npm run db:migrate:oracle` / `npm run db:test:oracle`.
ORACLE_USER=
ORACLE_PASSWORD=
ORACLE_CONNECT_STRING=
ORACLE_WALLET_LOCATION=
ORACLE_WALLET_PASSWORD=
# Vercel/serverless option: base64 of the individual wallet files. Do not
# commit their values. When supplied, files are reconstructed under /tmp.
ORACLE_WALLET_EWALLET_PEM_BASE64=
ORACLE_WALLET_CWALLET_SSO_BASE64=
ORACLE_WALLET_TNSNAMES_ORA_BASE64=
ORACLE_WALLET_SQLNET_ORA_BASE64=
ORACLE_POOL_MIN=0
ORACLE_POOL_MAX=4
ORACLE_POOL_INCREMENT=1
ORACLE_POOL_TIMEOUT_SECONDS=60
ORACLE_QUEUE_TIMEOUT_MS=10000
ORACLE_CONNECT_TIMEOUT_SECONDS=15
